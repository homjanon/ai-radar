{
  "note": "AI 前沿雷达 · 源配置（单一数据源，改配置不改代码）。mode=direct 走 urls[] 顺序兜底；mode=rsshub 走 rsshub_pool 实例顺序兜底（命中即止）。desc_min 为该源可接受的 desc 中位长度门槛（字），低于门槛继续试下一实例——沿用 portfolio 的踩坑经验：各 rsshub 实例返回的 desc 深浅不一（导语版 vs 全文版），若不设门槛会锁死在导语版实例上，直接损害 LLM 摘要质量。enabled=false 为候选源（P0 探测后再决定是否启用）。",
  "version": "2026-09-28",
  "rsshub_pool": [
    "hub.slarker.me",
    "rsshub.rssforever.com",
    "rsshub.umzzz.com",
    "rsshub.isrss.com",
    "rsshub.ktachibana.party",
    "rsshub-balancer.virworks.moe"
  ],
  "translate": {
    "summary_min": 40,
    "summary_max": 80,
    "models": [
      { "name": "gemini-3-flash", "base": "https://generativelanguage.googleapis.com/v1beta/openai", "model": "gemini-3-flash-preview", "key_env": "GEMINI_API_KEY" },
